# ── Dependencies ──────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build outputs ─────────────────────────────────────────────
dist/
build/
.next/
out/
.output/

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
.eggs/
dist/
*.dist-info/

# ── Trendscraper runtime ──────────────────────────────────────
Trendscraper/trendscraper.db
Trendscraper/logs/
Trendscraper/.env

# ── Env files ─────────────────────────────────────────────────
# .env bevat echte API keys en mag NOOIT gecommit worden.
# Gebruik .env.example als template (zie README → Environment Setup).
.env
.env.local
.env.*.local

# ── SQLite databases ─────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
# De zijbestanden MOETEN hier ook staan: `*.db` dekt `dropship.db-wal` niet.
# Een meegecommitte WAL hoort niet bij de database die op de server staat.
# SQLite ziet dan een vreemde WAL naast een bekende database en weigert met
# SQLITE_CORRUPT ("database disk image is malformed"). Omdat de deploy
# `git reset --hard` doet, werd de productie-WAL bij élke deploy overschreven
# met die van een dev-machine — goed voor 1982 crashloop-herstarts.
*.db-wal
*.db-shm
*.db-journal

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/

# ── OS / editor ───────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
*.swp
*.swo

# ── Vite / cache ──────────────────────────────────────────────
.vite/
*.tsbuildinfo

# ── Bun ───────────────────────────────────────────────────────
.bun/
bun.lockb

# ── Test coverage ─────────────────────────────────────────────
coverage/
.nyc_output/

# memory/logs/ bevat verificatie-bewijs per fase, geen runtime-logs
!memory/logs/
!memory/logs/**

# ── Gegenereerde beelden ──────────────────────────────────────
# image-gen.ts schrijft hero-/product-/ad-beelden per store hierheen. Runtime-
# artefacten, geen broncode — en op de VPS lopen ze snel in de honderden MB's.
UIcontrol/data/images/

# ── Losse output van de verify:*-scripts ──────────────────────
# Die schrijven naar $LOGFILE, of naar de projectmap als die niet gezet is.
# Het bewijs hoort in memory/logs/, niet als kladbestand in de repo.
UIcontrol/assortment.txt
UIcontrol/collection-render.txt
UIcontrol/search-efficiency.txt
UIcontrol/relevance.txt
UIcontrol/subdomain-cleanup.txt
UIcontrol/marketing.txt
UIcontrol/preset-library.txt
UIcontrol/batch-research.txt
UIcontrol/small-assortment.txt
